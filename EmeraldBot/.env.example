# Copy this file to .env and fill in your values
# NEVER share your .env file

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# The shared secret — must EXACTLY match HUB_SECRET in Main.lua
# Use a long random string. Example: openssl rand -hex 24
HUB_SECRET=CHANGE_THIS_TO_YOUR_OWN_SECRET

# (Optional) Only allow key generation in this specific channel ID
# Leave blank to allow in any channel the bot can see
KEYGEN_CHANNEL_ID=

# (Optional) Require users to have this role ID before getting a key
# Leave blank to allow anyone to get a key
REQUIRED_ROLE_ID=

# (Optional) Discord server (guild) ID — for server membership check
GUILD_ID=
